# AI Vector — environment template.
#
# Copy to `.env` at the repo root and fill in real values for local dev.
# `.env` is gitignored. In CI, these are injected as GitHub repo secrets,
# not via this file.
#
# Consumed by: src/run.py (loads via python-dotenv), then read from
# os.environ by src/rank.py and src/summarise.py.
#
# NOTE: Embeddings are NOT configured here — they run from a local
# HuggingFace model loaded in-process by src/cluster.py. See
# docs/internal/DESIGN.md → "LLM endpoint configuration" for the full contract.

# --- Required ---------------------------------------------------------------

# Provider/protocol id. One of: anthropic | bedrock | openai | litellm | ollama
# - anthropic + bedrock use native SDKs.
# - openai/litellm/ollama share the OpenAI-compatible Chat Completions path
#   (any gateway speaking that protocol works — Together, Groq, vLLM, etc.).
LLM_PROVIDER=anthropic

# Base URL of the LLM API.
# Examples:
#   anthropic : https://api.anthropic.com
#   bedrock   : https://bedrock-runtime.us-east-1.amazonaws.com
#   openai    : https://api.openai.com/v1
#   litellm   : http://localhost:4000/v1   (proxy default)
#   ollama    : http://localhost:11434/v1  (OpenAI-compat mode)
LLM_ENDPOINT=https://api.anthropic.com

# Authentication key / token. SECRET — never log, never commit.
# For Bedrock with ambient AWS creds you may leave this blank.
# For Ollama on localhost the API key may be unused (leave blank).
LLM_API_KEY=replace-me

# Model identifier as the provider expects it.
# Examples:
#   anthropic : claude-sonnet-5-5   (recommended default — fast + capable)
#   anthropic : claude-opus-5-5     (higher quality, slower, 2x cost)
#   bedrock   : anthropic.claude-sonnet-5-5
#   openai    : gpt-4o
#   litellm   : whatever_alias_your_proxy_maps  (e.g. claude-sonnet-5-5)
#   ollama    : llama3.1:70b
LLM_MODEL=claude-sonnet-5-5

# --- Optional ---------------------------------------------------------------

# Per-call wall-clock timeout (seconds). Default: 60
LLM_TIMEOUT_SECONDS=60

# Thinking effort for Claude 5 models (claude-sonnet-5-5, claude-opus-5-5,
# ...), where extended thinking is always on and cannot be switched off.
# One of: low, medium, high, xhigh, max. Thinking tokens are billed as
# output and count toward each call's max_tokens, so the pipeline defaults
# Claude 5 models to `low` and sends nothing for older models. Applies to
# every pipeline stage (the eval judge has its own EVAL_JUDGE_EFFORT).
LLM_EFFORT=low

# Set to `off` to send no extended thinking at all. Only claude-sonnet-5-5
# accepts this (as `thinking: between_tools`, effort high or below); it is
# ignored for every other model. Default: unset (thinking on, at LLM_EFFORT).
LLM_THINKING=

# Temperature for rank.py. Low for stability across re-runs. Default: 0.2
LLM_TEMPERATURE_RANK=0.2

# Temperature for summarise.py. Higher to give voice texture room. Default: 0.6
LLM_TEMPERATURE_SUMMARISE=0.6

# Temperature for revise.py. Low: a revision repairs prose that already
# exists rather than drafting new voice. Default: 0.2
LLM_TEMPERATURE_REVISE=0.2

# --- Editorial reviewer (src/review.py) --------------------------------------
# Which model runs the pre-release editorial review. Falls back to LLM_MODEL
# when unset.
#
# SET THIS TO A DIFFERENT MODEL THAN THE WRITER. A model reviewing prose a
# sibling model wrote is measurably softer on it — same training, same
# habits, same blind spots — and the reviewer's whole job is to catch what
# the writer did not see. The recommended value mirrors EVAL_JUDGE_MODEL:
# the stronger model judges, the faster model writes.
#
# Recommended: claude-opus-5-5   (with LLM_MODEL=claude-sonnet-5-5)
REVIEW_MODEL=claude-opus-5-5

# Per-call timeout for the review LLM request (seconds). Deliberately
# separate from LLM_TIMEOUT_SECONDS: the review asks for a long structured
# response and the shared 60s default truncates it mid-generation.
# Default: 180
LLM_REVIEW_TIMEOUT_SECONDS=180

# Per-call timeout for each field-level revision request (seconds).
# Revisions are small — one field in, one field out. Default: 90
LLM_REVISE_TIMEOUT_SECONDS=90

# LLM call concurrency for rank.py (and later other stages). Default 8.
# Anthropic build-tier-1 supports 50 RPM; tier-4 supports 4000 RPM. Set
# based on your tier. Cap is 50.
LLM_CONCURRENCY=8

# --- Eval judge (optional; defaults to Anthropic Opus) -------
# Judge runs a different model from the generation model to mitigate
# same-model bias. Uses the same LLM_API_KEY and LLM_ENDPOINT as the
# generation pipeline -- no extra credentials needed.
EVAL_JUDGE_PROVIDER=anthropic
EVAL_JUDGE_MODEL=claude-opus-4-7
EVAL_JUDGE_TIMEOUT_SECONDS=60
# Thinking effort for a Claude 5 judge (see LLM_EFFORT). Default: low
EVAL_JUDGE_EFFORT=low

# `aiv cost --reconcile` only: an Admin API key (sk-ant-admin..., created by
# an organisation admin in the Claude Console; not available on individual
# accounts) to read what Anthropic actually billed. Plain `aiv cost` needs
# neither of these.
ANTHROPIC_ADMIN_KEY=
# Optional: the apikey_... id of the key the pipeline uses (Console -> API
# keys), so the billed column covers this newsletter, not the whole org.
AIV_ANTHROPIC_API_KEY_ID=

# GoatCounter stats API token (Settings -> user -> API) for readership reporting
GOATCOUNTER_API_TOKEN=
