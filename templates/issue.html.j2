{#- Advisory verify badges. Operator UI: rendered only under show_verify_flags,
    i.e. in docs/staging/. Released HTML never carries them. -#}
{%- macro verify_flag(block) -%}
{%- if block.verification -%}
{%- if block.verification.headline_flagged -%}
<span class="op-flag hard" title="Headline claim flagged by the advisory verifier">&#9888; headline claim flagged</span>
{%- elif block.verification.has_contradiction -%}
<span class="op-flag hard" title="Contradicted claim detected by the advisory verifier">&#9888; contradicted</span>
{%- elif block.verification.has_unsupported -%}
<span class="op-flag" title="Unsupported claim detected by the advisory verifier">&#9888; unsupported claim</span>
{%- endif -%}
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.name }} &mdash; {% if issue.display_number %}Issue No. {{ issue.display_number }}{% else %}Preview{% endif %} &middot; {{ issue.date.strftime('%d %B %Y') }}</title>
<meta name="description" content="{{ pulse_story.headline }}. {% if issue.display_number %}Issue No. {{ issue.display_number }} of {{ brand.name }}.{% else %}A staging preview of {{ brand.name }}.{% endif %}">
<meta name="theme-color" content="#faf9f5">
<link rel="icon" type="image/svg+xml" href="../favicon.svg">
<link rel="mask-icon" href="../favicon.svg" color="#3b352d">
<link rel="stylesheet" href="../fonts/fonts.css">
<style>
:root{
  --paper:oklch(0.987 0.004 95);--paper-2:oklch(0.965 0.006 90);
  /* --ink-3 is 0.55, NOT the palette's 0.56. Measured on --paper, 0.56 gives
     4.49:1 -- a hundredth under the 4.5:1 AA floor for normal text, and the
     dateline, caveats and footer are all normal text at 11px. 0.55 gives
     4.68:1. Held deliberately; see the colour note in READING_EXPERIENCE.md. */
  --ink:oklch(0.255 0.012 60);--ink-2:oklch(0.46 0.012 62);--ink-3:oklch(0.55 0.010 66);
  --line:oklch(0.905 0.006 80);--line-2:oklch(0.845 0.008 78);
  /* Accent: warm vermilion (~#9f3b2e), 6.45:1 on --paper. The palette rule is
     never blue, navy or black as an accent -- every accent on this page runs
     through this one token, so the swap is this line plus a:hover. */
  --accent:oklch(0.49 0.135 30);
  /* Sanctioned semantic triad, for badge surfaces we have not built yet:
       rust  oklch(0.55 0.090 45)  -- 4.84:1 on --paper
       amber oklch(0.54 0.085 72)  -- 4.95:1 on --paper
       sage  oklch(0.52 0.075 156) -- 5.11:1 on --paper
     Deliberately NOT declared as tokens: the evidence chip they were built
     for is deleted, and dead tokens in a permanent artifact are what got us
     here. The authoritative record lives in READING_EXPERIENCE.md. */
  /* The text measure. One token, so the operator banner below can track the
     column instead of restating its width. */
  --measure:620px;
  --serif:'Newsreader',Georgia,'Times New Roman',serif;
  --mono:'IBM Plex Mono',ui-monospace,'SFMono-Regular',Menlo,monospace;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--paper-2);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
body{font-family:var(--serif);color:var(--ink);font-size:18px;line-height:1.65}
a{color:var(--accent)}a:hover{color:oklch(0.40 0.135 30)}
.page{max-width:812px;margin:0 auto;background:var(--paper);box-shadow:0 1px 3px rgba(12,12,12,.04),0 12px 60px rgba(12,12,12,.06);padding:64px 96px 76px}
.measure{max-width:var(--measure);margin:0 auto;width:100%}
/* Inline code. Real summaries carry literal `backticks` (six occurrences in
   the released archive); the `code_spans` filter turns them into this. */
code{font-family:var(--mono);font-size:.85em;background:var(--paper-2);padding:.1em .3em;border-radius:2px}
.kicker{font-family:var(--mono);font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-2);white-space:nowrap}
.kicker.accent{color:var(--accent)}
.rule{height:2px;background:var(--ink);border:0;margin:0}
.hr{height:1px;background:var(--line);border:0;margin:0}
.tag{display:inline-flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10.5px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:var(--accent)}
.tag::before{content:'';width:14px;height:1.5px;background:var(--accent);display:inline-block}
.src{position:relative;font-family:var(--mono);font-size:11px;color:var(--ink-2);text-decoration:none;border-bottom:1px solid var(--line-2);padding-bottom:1px;white-space:nowrap}
.src .arw{color:var(--accent)}
/* Quiet navigation links. Same register as .src -- mono, ink-2, a hairline
   underline from --line-2, accent on hover. Reusing that pattern rather than
   inventing one keeps the page to a single "this is a link" signal. */
.navlink{font-family:var(--mono);color:var(--ink-2);text-decoration:none;border-bottom:1px solid var(--line-2);padding-bottom:1px;white-space:nowrap}
.navlink:hover{color:var(--accent);border-bottom-color:var(--accent)}
.masthead{display:flex;align-items:baseline;justify-content:space-between;gap:16px}
/* The lockup is the home link. No visual change: colour is inherited so the
   wordmark stays ink and the slash keeps its accent, and there is no underline
   and no hover shift -- a 32px masthead recolouring on hover would be loud. */
.brand a,.brand a:hover{color:inherit;text-decoration:none}
.brand{font-family:var(--serif);font-weight:500;font-size:32px;letter-spacing:-.02em;margin:0}
/* The mark. Ink, never accent -- the accent is spent on the slash. An
   inline-block on the text baseline leaves .masthead's baseline alignment
   (and so the meta line on the right) exactly where it was. */
.brand .mark{display:inline-block;width:22px;height:22px;margin-right:14px;vertical-align:baseline;color:var(--ink)}
.brand .mark svg{display:block;width:100%;height:100%;fill:currentColor}
.brand .slash{color:var(--accent)}
.mast-meta{font-family:var(--mono);font-size:11.5px;color:var(--ink-3);white-space:nowrap}
.mast-meta .navlink{font-size:11.5px}
.skim-head,.full-head{display:flex;align-items:baseline;gap:12px;margin-bottom:16px}
.skim-head .hr,.full-head .hr{flex:1}
.skim p{margin:0 0 13px;font-size:18px;line-height:1.55}
.skim p:last-child{margin-bottom:0}
.skim strong{font-weight:600}
.skim span{color:var(--ink-2)}
h1{margin:0;font-weight:500;font-size:35px;line-height:1.12;letter-spacing:-.015em}
.takeaway{margin:0;font-size:18.5px;line-height:1.65;font-weight:600}
.dek{margin:0;font-size:17.5px;line-height:1.65;color:var(--ink-2)}
.dek em{color:var(--ink-3)}
.story-meta{display:flex;align-items:center;gap:18px;margin-top:2px}
.story-meta .src{margin-left:auto}
.section-head{border-top:2px solid var(--ink);padding-top:20px}
.section-head .row{display:flex;align-items:baseline;justify-content:space-between}
.section-head h2{margin:0;font-weight:500;font-size:27.5px;letter-spacing:-.01em}
.section-head .synthesis{margin:12px 0 0;font-style:italic;font-size:17px;line-height:1.55;color:var(--ink-2)}
article h3{margin:0;font-weight:500;font-size:24px;line-height:1.2;letter-spacing:-.008em}
article .takeaway{font-size:18px}
article .dek{font-size:17.5px}
.stack{display:flex;flex-direction:column;gap:12px}
/* Stack rhythm: 12px holds headline+take together as one co-read unit; the
   extra 6px opens the gap to 18px before the summary, so the eye sees a
   group and then a body, not three evenly spaced paragraphs. */
.stack>.takeaway{margin-bottom:6px}
.gap14{display:flex;flex-direction:column;gap:14px}
.issue{display:flex;flex-direction:column;gap:42px}
.section{display:flex;flex-direction:column;gap:32px}
/* Colophon: wordmark, by-line, ethos packed left on a 14px rhythm, with the
   archive link pushed to the right edge by margin-left:auto -- the same trick
   .story-meta .src already uses, so the page has one alignment idiom. Wraps
   on narrow screens instead of overflowing. */
footer.colophon{border-top:2px solid var(--ink);padding-top:16px;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;row-gap:8px}
footer.colophon .brand-sm{font-weight:500;font-size:19px}
footer.colophon .by{font-family:var(--mono);font-size:11px;color:var(--ink-3)}
footer.colophon .ethos{font-family:var(--mono);font-size:11px;color:var(--ink-3)}
footer.colophon .navlink{font-size:11px}
/* The two nav links travel as one unit so a narrow measure wraps them
   together to the next line rather than splitting them across two. */
footer.colophon .colo-nav{margin-left:auto;display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
@media(max-width:720px){.page{padding:44px 24px 52px}h1{font-size:28.5px}article h3{font-size:21px}.story-meta{flex-wrap:wrap}.story-meta .src{margin-left:0}
/* Tap target. The visible source link is ~13px tall, far under the 44px
   minimum. This overlay grows the hit area without moving a pixel of the
   meta row: vertical padding plus a negative margin would have dragged the
   border-bottom underline ~16px away from the text it underlines. */
.src::after{content:'';position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);height:44px}}
/* Phone. Without this the measure fell to roughly 38 characters per line. */
@media(max-width:480px){.page{padding:34px 16px 44px}body{font-size:17px}h1{font-size:29px}article h3{font-size:21px}
/* The meta line gained "All issues" and can no longer be guaranteed to fit on
   one line on a small phone. Let it wrap rather than overflow the page. */
.mast-meta{white-space:normal}}
</style>
{%- if show_verify_flags %}
<style>
/* ── Operator UI: STAGING PREVIEW ONLY ─────────────────────────────────────
   Everything in this block is emitted only when show_verify_flags is true,
   i.e. render(mode="preview") -> docs/staging/. A released page never carries
   a single byte of it, so docs/released/ CSS is exactly the design CSS above.
   Guarded jointly with the Experience Designer. */
.op-dup-gate{max-width:var(--measure);margin:0 auto;width:100%;border:2px solid oklch(0.50 0.18 25);border-left-width:8px;background:oklch(0.97 0.02 25);padding:16px 20px;color:oklch(0.35 0.14 25);font-family:var(--mono);font-size:12.5px;line-height:1.55}
.op-dup-gate-head{font-weight:600;letter-spacing:.08em;text-transform:uppercase;margin-bottom:8px}
.op-dup-gate p{margin:0 0 8px}
.op-dup-gate pre{margin:0;padding:10px 12px;background:oklch(0.25 0.06 25);color:oklch(0.93 0.03 25);font-family:var(--mono);font-size:12px;line-height:1.6;overflow-x:auto}
.op-flag{font-family:var(--mono);font-size:10px;font-weight:500;letter-spacing:.06em;text-transform:uppercase;color:oklch(0.45 0.12 60);border:1px solid oklch(0.72 0.11 70);background:oklch(0.96 0.04 80);padding:1px 6px;white-space:nowrap}
.op-flag.hard{color:oklch(0.42 0.16 25);border-color:oklch(0.66 0.15 25);background:oklch(0.96 0.04 25)}
</style>
{%- endif %}
</head>
<body>
<main class="page">
<div class="issue">
{% if dup_risk_dates %}
<aside class="op-dup-gate" role="alert">
  <div class="op-dup-gate-head">&#9888; Duplicate risk &mdash; do not publish as-is</div>
  <p>
    {{ dup_risk_dates|length }} earlier issue{{ '' if dup_risk_dates|length == 1 else 's' }}
    ({{ dup_risk_dates|join(', ') }}) {{ 'is' if dup_risk_dates|length == 1 else 'are' }}
    staged but <strong>not yet released</strong>. Cross-time dedup reads the released
    archive only, so it could not see {{ 'it' if dup_risk_dates|length == 1 else 'them' }} &mdash;
    this issue may repeat stories already covered there.
  </p>
  <p>
    <strong>Remedy:</strong> release the earlier issue{{ '' if dup_risk_dates|length == 1 else 's' }}
    oldest-first, then re-run this date so dedup can see {{ 'it' if dup_risk_dates|length == 1 else 'them' }}:
  </p>
  <pre>{% for d in dup_risk_dates %}aiv release --date {{ d }}
{% endfor %}aiv run --date {{ issue.date.isoformat() }}</pre>
</aside>
{% endif %}
<header class="measure">
  <div class="masthead">
    <div class="brand"><a href="../index.html"><span class="mark" aria-hidden="true">{% include "_mark.svg.j2" %}</span>{{ brand.wordmark.lead }}<span class="slash">/</span>{{ brand.wordmark.tail }}</a></div>
    <span class="mast-meta">{% if issue.display_number %}No. {{ issue.display_number }}{% else %}Preview{% endif %} &middot; {{ issue.date.strftime('%d %b') }} &middot; {{ read_minutes }} min &middot; <a class="navlink" href="../index.html">All issues &rarr;</a></span>
  </div>
  <hr class="rule" style="margin-top:14px">
</header>
{% if digest %}
<section class="measure">
  <div class="skim-head"><span class="kicker accent">The 30-second read</span><hr class="hr"></div>
  <div class="skim">
{%- for d in digest %}
    <p>{% if d.lead %}<strong>{{ d.lead | code_spans }}</strong>{% endif %}{% if d.lead and d.sentence %} {% endif %}{% if d.sentence %}<span>{{ d.sentence | code_spans }}</span>{% endif %}</p>
{%- endfor %}
  </div>
</section>
{% endif %}
<section class="measure gap14">
{#- "The full read" only earns its place as the counterpart to "The
    30-second read". With no digest above it, the label names a contrast
    that is not on the page and reads as an orphan. -#}
{%- if digest %}
  <div class="full-head"><span class="kicker">The full read</span><hr class="hr"></div>
{%- endif %}
  <div class="kicker accent" style="margin-top:10px">The Pulse &middot; Story of the day</div>
  <h1>{{ pulse_story.headline }}</h1>
{%- if pulse_story.take %}
  <p class="takeaway">{{ pulse_story.take | code_spans }}</p>
{%- endif %}
  <p class="dek">{{ pulse_story.summary | code_spans }}</p>
  <div class="story-meta">
{%- if show_verify_flags %}{{ verify_flag(pulse_story) }}{% endif %}
{%- for url in pulse_story.source_urls %}
    <a class="src" href="{{ url }}" target="_blank" rel="noreferrer">{{ url | source_label }} <span class="arw">&rarr;</span></a>
{%- endfor %}
  </div>
</section>
{#- An empty section still renders when it carries text: the quiet-day
    line (new contract) or a legacy quiet-day intro (archive issues) is
    published content, not an empty shell. -#}
{% for section in issue.sections %}{% if section.stories or section_synthesis(section) %}
<section class="section {{ section.name }}">
  <div class="section-head measure">
    <div class="row"><h2>{{ section_title(section.name) }}</h2>{% if section.stories %}<span class="kicker">{{ section.stories|length }} {% if section.name in ('currents', 'on_the_radar') %}{{ 'item' if section.stories|length == 1 else 'items' }}{% else %}{{ 'story' if section.stories|length == 1 else 'stories' }}{% endif %}</span>{% endif %}</div>
{#- A synthesis over a single story is just that story restated, so it is
    suppressed at EXACTLY one story. Zero stories is the quiet-day case:
    that synthesis is the section's only content and must render. The
    suppression applies ONLY to the v4 synthesis field -- legacy
    intro_lead/intro_body text is ratified published content on archive
    issues at any story count and must never be dropped. -#}
{%- set synthesis = section_synthesis(section) %}
{%- if synthesis and (section.stories|length != 1 or not section.synthesis) %}
    <p class="synthesis">{{ synthesis | code_spans }}</p>
{%- endif %}
  </div>
{%- for story in section.stories %}
  <article class="measure stack">
    <h3>{{ story.headline }}</h3>
{%- if story.take %}
    <p class="takeaway">{{ story.take | code_spans }}</p>
{%- endif %}
    <p class="dek">{{ story.summary | code_spans }}</p>
    <div class="story-meta">
{%- set tag = story_tag(story, section.name) %}
{%- if tag %}<span class="tag">{{ tag }}</span>{% endif %}
{%- if show_verify_flags %}{{ verify_flag(story) }}{% endif %}
{%- for url in story.source_urls %}
      <a class="src" href="{{ url }}" target="_blank" rel="noreferrer">{{ url | source_label }} <span class="arw">&rarr;</span></a>
{%- endfor %}
    </div>
  </article>
{%- endfor %}
</section>
{% endif %}{% endfor %}
<footer class="colophon measure">
  <span class="brand-sm">{{ brand.wordmark.lead }}<span class="slash" style="color:var(--accent)">/</span>{{ brand.wordmark.tail }}</span>
{#- The by-line links to the author when brand.author_url is set, and degrades
    to plain text when it is not, so a fork that clears it is never left with
    an anchor pointing nowhere. -#}
  <span class="by">{% if brand.author_url %}<a class="navlink" href="{{ brand.author_url }}">{{ brand.author }}</a>{% else %}{{ brand.author }}{% endif %}</span>
  <span class="ethos">{{ brand.ethos }}</span>
  <span class="colo-nav"><a class="navlink" href="../how-its-made.html">how it's made &rarr;</a><a class="navlink" href="../index.html">all issues &rarr;</a></span>
</footer>

</div>
</main>
{% if brand.goatcounter %}<script data-goatcounter="https://{{ brand.goatcounter }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
{% endif %}</body>
</html>
