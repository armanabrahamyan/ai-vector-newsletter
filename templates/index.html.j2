<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ brand.name }} &mdash; {{ brand.tagline }}</title>
  <meta name="description" content="{{ brand.tagline }} {{ brand.description }}">
  <meta name="theme-color" content="#faf9f5">
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="mask-icon" href="favicon.svg" color="#3b352d">
  <link rel="stylesheet" href="fonts/fonts.css">
  <style>
    :root{
      --paper: oklch(0.987 0.004 95); --paper-2: oklch(0.965 0.006 90);
      /* --ink-3 is 0.55, NOT the palette's 0.56. Measured on --paper, 0.56
         gives 4.49:1 -- a hundredth under the 4.5:1 AA floor for normal text.
         0.55 gives 4.68:1. Held deliberately; matches the issue template. */
      --ink: oklch(0.255 0.012 60); --ink-2: oklch(0.46 0.012 62); --ink-3: oklch(0.55 0.010 66);
      --line: oklch(0.905 0.006 80); --line-2: oklch(0.845 0.008 78);
      /* Accent: warm vermilion (~#9f3b2e), 6.45:1 on --paper. --accent-2 is
         its pale tint, used for row hover and search highlights; it moved to
         the same hue so no blue survives anywhere on the page. */
      --accent: oklch(0.49 0.135 30); --accent-2: oklch(0.95 0.03 30);
      --serif: 'Newsreader', Georgia, 'Times New Roman', serif;
      --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin:0; padding:0; background: var(--paper-2); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
    body { font-family: var(--serif); color: var(--ink); font-size: 18px; line-height: 1.65; }
    a { color: var(--accent); }
    a:hover { color: oklch(0.40 0.135 30); }
    .page { max-width: 812px; margin: 0 auto; background: var(--paper); box-shadow: 0 1px 3px rgba(12,12,12,0.04), 0 12px 60px rgba(12,12,12,0.06); padding: 64px 96px 76px; }
    /* Matches the issue page's inline code. The hero digest is the only
       place on this page that renders generated prose. */
    code { font-family: var(--mono); font-size: 0.85em; background: var(--paper-2); padding: 0.1em 0.3em; border-radius: 2px; }

    /* masthead */
    .masthead { display:flex; align-items:flex-end; justify-content:space-between; gap:32px; padding-bottom:18px; border-bottom:2px solid var(--ink); margin-bottom:30px; }
    .brand { font-family: var(--serif); font-size: 52px; font-weight: 500; letter-spacing: -0.02em; line-height: 0.95; margin: 0; color: var(--ink); }
    /* The mark. Ink, never accent. Sized to the wordmark's cap-height at each
       breakpoint (Newsreader measures 0.6816 em), so it reads as a letter in
       the lockup rather than a picture beside it. */
    .brand .mark { display: inline-block; width: 36px; height: 36px; margin-right: 23px; vertical-align: baseline; color: var(--ink); }
    .brand .mark svg { display: block; width: 100%; height: 100%; fill: currentColor; }
    .brand .slash { color: var(--accent); }
    /* The lockup is the home link. Colour inherited so the wordmark stays ink
       and the slash keeps its accent; no underline, no hover shift. */
    .brand a, .brand a:hover { color: inherit; text-decoration: none; }
    .mast-meta { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); text-align: right; line-height: 1.7; white-space: nowrap; }
    /* Quiet navigation link — same register the issue pages use. Sits under
       the mast subtitle so the standing page is reachable from the top of the
       site without competing with the archive, which is the real navigation. */
    .navlink { font-family: var(--mono); color: var(--ink-2); text-decoration: none; border-bottom: 1px solid var(--line-2); padding-bottom: 1px; white-space: nowrap; }
    .navlink:hover { color: var(--accent); border-bottom-color: var(--accent); }

    .tagline { font-family: var(--serif); font-style: italic; font-size: 21px; color: var(--ink); margin: 0 0 18px; letter-spacing: -0.01em; line-height: 1.3; }
    .tagline .mark { color: var(--accent); margin-right: 12px; font-style: normal; }
    .about { font-family: var(--serif); font-size: 16.5px; line-height: 1.6; color: var(--ink-2); margin: 0 0 48px; max-width: 50em; text-wrap: pretty; }

    /* latest issue */
    .latest { margin: 0 0 52px; padding: 26px 30px 28px; background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--accent); }
    .latest .kicker { font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); margin: 0 0 12px; display: flex; align-items: center; gap: 12px; }
    .latest .kicker .bar { display: inline-block; width: 28px; height: 1.5px; background: var(--accent); }
    .latest .meta { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin: 0 0 10px; }
    .latest h3 { font-family: var(--serif); font-size: 29px; font-weight: 500; letter-spacing: -0.015em; line-height: 1.16; margin: 0 0 18px; color: var(--ink); text-wrap: balance; }
    .latest .read { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: 13px; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--line-2); padding-bottom: 2px; }
    .latest .read:hover { border-bottom-color: var(--accent); }

    .latest .skim { display: flex; flex-direction: column; gap: 10px; margin: 0 0 18px; }
    .latest .skim p { margin: 0; font-family: var(--serif); font-size: 16px; line-height: 1.5; }
    .latest .skim strong { font-weight: 600; }
    .latest .skim span { color: var(--ink-2); }
    .latest .skim em { color: var(--ink-3); font-size: 13px; }

    /* archive */
    .archive-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding-top: 8px; padding-bottom: 12px; border-bottom: 2px solid var(--ink); margin: 0 0 18px; }
    .archive-head h2 { font-family: var(--serif); font-size: 27px; font-weight: 500; letter-spacing: -0.01em; line-height: 1.1; margin: 0; color: var(--ink); }
    .archive-head .count { font-family: var(--mono); font-size: 11px; color: var(--ink-3); letter-spacing: 0.08em; text-transform: uppercase; }
    .archive ul { list-style: none; padding: 0; margin: 0; }

    /* search */
    .archive-search { position: relative; margin: 0 0 22px; }
    .archive-search input { width: 100%; border: none; border-bottom: 1px solid var(--line-2); background: transparent; padding: 10px 0 10px 26px; font-family: var(--serif); font-size: 16px; color: var(--ink); outline: none; transition: border-color 120ms ease; }
    .archive-search input:focus { border-bottom-color: var(--accent); }
    .archive-search input::placeholder { color: var(--ink-3); font-style: italic; }
    .archive-search::before { content: "\2315"; position: absolute; left: 2px; top: 50%; transform: translateY(-55%); color: var(--ink-3); font-size: 16px; pointer-events: none; }
    .archive-search kbd { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-family: var(--mono); font-size: 11px; color: var(--ink-3); border: 1px solid var(--line-2); padding: 2px 6px; border-radius: 3px; pointer-events: none; }
    .archive-search.focused kbd, .archive-search.has-value kbd { display: none; }
    .archive-search .clear { position: absolute; right: 0; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--ink-3); font-size: 11px; cursor: pointer; padding: 6px 8px; font-family: var(--mono); letter-spacing: 0.08em; text-transform: uppercase; display: none; }
    .archive-search.has-value .clear { display: inline-block; }
    .archive-search .clear:hover { color: var(--accent); }

    /* month groups */
    details.month { margin: 0; border-bottom: 1px solid var(--line); }
    details.month:last-of-type { border-bottom: none; }
    details.month > summary { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 15px 0; cursor: pointer; list-style: none; user-select: none; }
    details.month > summary::-webkit-details-marker { display: none; }
    details.month > summary::marker { content: ""; }
    .month-name { font-family: var(--serif); font-size: 18px; font-weight: 600; letter-spacing: -0.005em; color: var(--ink); display: flex; align-items: baseline; gap: 12px; }
    .month-chev { display: inline-block; width: 10px; color: var(--ink-3); font-size: 11px; transition: transform 160ms ease, color 160ms ease; }
    details.month[open] > summary .month-chev { transform: rotate(90deg); color: var(--accent); }
    .month-count { font-family: var(--mono); font-size: 11px; color: var(--ink-3); letter-spacing: 0.08em; text-transform: uppercase; }
    details.month ul { padding: 0 0 8px; }
    details.month li { border-top: 1px solid var(--paper-2); }
    details.month li:first-child { border-top: 1px solid var(--line); }
    details.month a { display: grid; grid-template-columns: 106px 52px 1fr auto; column-gap: 18px; align-items: baseline; padding: 13px 0; text-decoration: none; color: inherit; transition: background 120ms ease, padding 120ms ease, margin 120ms ease; }
    details.month a:hover { background: var(--accent-2); padding-left: 12px; padding-right: 12px; margin-left: -12px; margin-right: -12px; }
    details.month a:hover .arrow { transform: translateX(4px); color: var(--accent); }
    details.month .date { font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
    details.month .issue-num { font-family: var(--mono); font-size: 12.5px; color: var(--ink-3); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
    details.month .headline { font-family: var(--serif); font-size: 16.5px; font-weight: 500; color: var(--ink); line-height: 1.32; letter-spacing: -0.005em; text-wrap: balance; }
    details.month .arrow { color: var(--line-2); font-size: 15px; transition: transform 120ms ease, color 120ms ease; }
    mark.hit { background: var(--accent-2); color: inherit; padding: 0 2px; }
    .no-results, .empty { padding: 32px 0; color: var(--ink-3); font-style: italic; text-align: center; }

    .recent-head { font-family: var(--mono); font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); padding: 4px 0 10px; }
    #recent-block ul { list-style: none; margin: 0 0 8px; padding: 0; }
    #recent-block li { border-bottom: 1px solid var(--paper-2); }
    #recent-block li:first-child { border-top: 1px solid var(--line); }
    #recent-block a { display: grid; grid-template-columns: 106px 52px 1fr auto; column-gap: 18px; align-items: baseline; padding: 13px 0; text-decoration: none; color: inherit; transition: background 120ms ease, padding 120ms ease, margin 120ms ease; }
    #recent-block a:hover { background: var(--accent-2); padding-left: 12px; padding-right: 12px; margin-left: -12px; margin-right: -12px; }
    #recent-block a:hover .arrow { transform: translateX(4px); color: var(--accent); }
    #recent-block .date { font-family: var(--mono); font-size: 12.5px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
    #recent-block .issue-num { font-family: var(--mono); font-size: 12.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
    #recent-block .headline { font-family: var(--serif); font-size: 16.5px; font-weight: 500; line-height: 1.32; }
    #recent-block .arrow { color: var(--line-2); font-size: 15px; transition: transform 120ms ease, color 120ms ease; }
    .expand-row { display: flex; justify-content: flex-end; margin: 14px 0 6px; }
    .expand-row button { background: none; border: none; cursor: pointer; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); padding: 4px 0; border-bottom: 1px solid var(--line-2); }
    .expand-row button:hover { color: var(--accent); border-bottom-color: var(--accent); }

    /* footer */
    footer { margin-top: 60px; padding-top: 22px; border-top: 2px solid var(--ink); display: flex; justify-content: space-between; align-items: baseline; font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2); flex-wrap: wrap; gap: 10px; }
    footer a { color: var(--ink-2); text-decoration: underline; }
    footer a:hover { color: var(--accent); }

    @media (max-width: 720px) {
      .page { padding: 44px 24px 52px; }
      .masthead { flex-direction: column; align-items: flex-start; gap: 14px; }
      .mast-meta { text-align: left; }
      .brand { font-size: 40px; }
      .brand .mark { width: 27px; height: 27px; margin-right: 17px; }
      .latest h3 { font-size: 24px; }
      details.month a { grid-template-columns: 1fr auto; grid-template-rows: auto auto; row-gap: 6px; }
      details.month .date { grid-column: 1; grid-row: 1; }
      details.month .issue-num { grid-column: 1; grid-row: 1; margin-left: 12px; }
      details.month .headline { grid-column: 1 / -1; grid-row: 2; }
      details.month .arrow { grid-column: 2; grid-row: 1; }
      .archive-search kbd { display: none; }
    }
    @media (max-width: 480px) {
      .page { padding: 34px 18px 44px; }
      .brand { font-size: 34px; }
      .brand .mark { width: 23px; height: 23px; margin-right: 15px; }
      .latest h3 { font-size: 21px; }
      body { font-size: 17px; }
    }
  </style>
</head>
<body>

<main class="page">

  <header class="masthead">
    <h1 class="brand"><a href="index.html"><span class="mark" aria-hidden="true">{% include "_mark.svg.j2" %}</span>{{ brand.wordmark.lead }}<span class="slash">/</span>{{ brand.wordmark.tail }}</a></h1>
    <div class="mast-meta">
      <div>{{ brand.landing_subtitle }}</div>
      <div><a class="navlink" href="how-its-made.html">How it's made &rarr;</a></div>
    </div>
  </header>

  <p class="tagline">
    <span class="mark">&mdash;</span>{{ brand.tagline }}
  </p>

  <p class="about">
    {{ brand.description }} {{ brand.ethos }}
  </p>

  {% if latest %}
    <section class="latest">
      <div class="kicker">
        <span class="bar"></span>
        <span>Latest issue &middot; {{ latest_kicker }}{% if latest_digest %} &middot; The 30-second read{% endif %}</span>
      </div>
      <div class="meta">{{ latest.date.strftime('%a %d %B %Y') }} &middot; Issue No. {{ latest.display_number }}</div>
      <h3>{{ latest.pulse_headline }}</h3>
      {%- if latest_digest %}
      <div class="skim">
        {%- for d in latest_digest %}
        <p>{% if d.lead %}<strong>{{ d.lead | code_spans }}</strong>{% endif %}{% if d.lead and d.sentence %} {% endif %}{% if d.sentence %}<span>{{ d.sentence | code_spans }}</span>{% endif %}</p>
        {%- endfor %}
      </div>
      {%- endif %}
      <a class="read" href="released/{{ latest.date.isoformat() }}.html">Read the full issue&nbsp;&rarr;</a>
    </section>

    {% if archive_data %}
      <section class="archive">
        <div class="archive-head">
          <h2>Released</h2>
          <span class="count" id="archive-count">&mdash;</span>
        </div>

        <div class="archive-search" id="archive-search">
          <input type="search" id="archive-search-input" placeholder="Search past issues..." autocomplete="off" aria-label="Search past issues">
          <kbd>/</kbd>
          <button type="button" class="clear" id="archive-search-clear" aria-label="Clear search">clear</button>
        </div>

        <div id="recent-block"></div>
        <div class="expand-row"><button type="button" id="expand-all">Expand all months</button></div>
        <div id="archive-list"></div>
      </section>

      <script id="archive-data" type="application/json">{{ archive_data | tojson }}</script>

      <script>
      (function () {
        const issues = JSON.parse(document.getElementById('archive-data').textContent);
        issues.sort((a, b) => b.date.localeCompare(a.date));

        const monthLabel = (iso) => {
          const d = new Date(iso + 'T00:00:00Z');
          return d.toLocaleString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
        };
        const monthKey = (iso) => iso.slice(0, 7);

        const groups = new Map();
        for (const it of issues) {
          const k = monthKey(it.date);
          if (!groups.has(k)) groups.set(k, { label: monthLabel(it.date), items: [] });
          groups.get(k).items.push(it);
        }

        const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

        // pinned recent 5
        const recent = issues.slice(0, 5);
        document.getElementById('recent-block').innerHTML =
          '<div class="recent-head">Recent</div><ul>' +
          recent.map((it) =>
            '<li><a href="' + esc(it.href) + '">' +
              '<span class="date">' + esc(it.date) + '</span>' +
              '<span class="issue-num">No. ' + (it.num_display || it.num) + '</span>' +
              '<span class="headline">' + esc(it.headline) + '</span>' +
              '<span class="arrow">→</span>' +
            '</a></li>').join('') + '</ul>';

        const list = document.getElementById('archive-list');
        let firstMonth = false; // all months start collapsed
        for (const [, g] of groups) {
          const det = document.createElement('details');
          det.className = 'month';
          if (firstMonth) { det.open = true; firstMonth = false; }
          det.innerHTML =
            '<summary>' +
              '<span class="month-name"><span class="month-chev">▸</span>' + esc(g.label) + '</span>' +
              '<span class="month-count">' + g.items.length + ' issue' + (g.items.length === 1 ? '' : 's') + '</span>' +
            '</summary>' +
            '<ul>' +
              g.items.map((it) =>
                '<li><a href="' + esc(it.href) + '" data-headline="' + esc(it.headline.toLowerCase()) + '">' +
                  '<span class="date">' + esc(it.date) + '</span>' +
                  '<span class="issue-num">No. ' + (it.num_display || it.num) + '</span>' +
                  '<span class="headline">' + esc(it.headline) + '</span>' +
                  '<span class="arrow">→</span>' +
                '</a></li>'
              ).join('') +
            '</ul>';
          list.appendChild(det);
        }

        const total = issues.length;
        document.getElementById('archive-count').textContent =
          total === 0 ? '—' : total + ' past issue' + (total === 1 ? '' : 's');

        const input = document.getElementById('archive-search-input');
        const clearBtn = document.getElementById('archive-search-clear');
        const wrap = document.getElementById('archive-search');
        const monthState = new WeakMap();

        const filter = (q) => {
          const query = q.trim().toLowerCase();
          const months = list.querySelectorAll('details.month');
          let anyHit = false;
          months.forEach((m) => {
            const links = m.querySelectorAll('li');
            let monthHas = false;
            links.forEach((li) => {
              const hl = li.querySelector('a').dataset.headline;
              const hit = !query || hl.includes(query);
              li.style.display = hit ? '' : 'none';
              if (hit) monthHas = true;
            });
            if (query) {
              if (!monthState.has(m)) monthState.set(m, m.open);
              m.open = monthHas;
              m.style.display = monthHas ? '' : 'none';
              if (monthHas) anyHit = true;
            } else {
              m.style.display = '';
              if (monthState.has(m)) { m.open = monthState.get(m); monthState.delete(m); }
            }
          });
          list.querySelectorAll('.headline').forEach((el) => {
            const raw = el.textContent;
            if (!query) { el.innerHTML = esc(raw); return; }
            const idx = raw.toLowerCase().indexOf(query);
            if (idx === -1) { el.innerHTML = esc(raw); return; }
            el.innerHTML =
              esc(raw.slice(0, idx)) +
              '<mark class="hit">' + esc(raw.slice(idx, idx + query.length)) + '</mark>' +
              esc(raw.slice(idx + query.length));
          });
          let empty = list.querySelector('.no-results');
          if (query && !anyHit) {
            if (!empty) {
              empty = document.createElement('div');
              empty.className = 'no-results';
              empty.textContent = 'No issues match.';
              list.appendChild(empty);
            }
          } else if (empty) {
            empty.remove();
          }
        };

        input.addEventListener('input', () => {
          wrap.classList.toggle('has-value', input.value.length > 0);
          filter(input.value);
        });
        input.addEventListener('focus', () => wrap.classList.add('focused'));
        input.addEventListener('blur',  () => wrap.classList.remove('focused'));
        clearBtn.addEventListener('click', () => {
          input.value = '';
          wrap.classList.remove('has-value');
          input.focus();
          filter('');
        });
        const expandBtn = document.getElementById('expand-all');
        let expanded = false;
        expandBtn.addEventListener('click', () => {
          expanded = !expanded;
          list.querySelectorAll('details.month').forEach((m) => { m.open = expanded; });
          expandBtn.textContent = expanded ? 'Collapse all months' : 'Expand all months';
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === '/' && document.activeElement !== input && !e.metaKey && !e.ctrlKey) {
            e.preventDefault();
            input.focus();
          } else if (e.key === 'Escape' && document.activeElement === input) {
            input.blur();
            if (input.value) { input.value = ''; wrap.classList.remove('has-value'); filter(''); }
          }
        });
      })();
      </script>
    {% endif %}
  {% else %}
    <p class="empty">No issues released yet.</p>
  {% endif %}

  <footer>
    {#- Author links to brand.author_url; degrades to plain text when unset. -#}
    <span>{{ brand.name }} &middot; {% if brand.author_url %}<a href="{{ brand.author_url }}">{{ brand.author }}</a>{% else %}{{ brand.author }}{% endif %}</span>
    <span>Page generated {{ generated_at | aest }}</span>
  </footer>

</main>

</body>
</html>
